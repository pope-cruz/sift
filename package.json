{
  "name": "sift",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "spike:send": "tsx src/spike/proactive-send.ts",
    "llm:check": "tsx src/spike/llm-check.ts",
    "live:run": "tsx src/spike/live-ingest.ts",
    "live:snapshot": "tsx src/spike/live-snapshot.ts",
    "phase3:preflight": "tsx src/spike/phase3-preflight.ts",
    "phase3:live": "tsx src/spike/live-phase3.ts",
    "phase3:audit": "tsx src/spike/phase3-audit.ts",
    "phase4:audit": "tsx src/spike/phase4-audit.ts",
    "phase4:controls": "tsx src/spike/phase4-control-check.ts",
    "remind:now": "tsx src/remind-now.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@supabase/supabase-js": "^2.112.2",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3",
    "spectrum-ts": "^12.7.0",
    "tsx": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
