{
  "name": "sort",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "tsc --noEmit && npm run build:api",
    "demo:dev": "tsx watch src/demo-dev.ts",
    "verify": "npm test && npm run typecheck && npm run lint && npm run build && git diff --exit-code -- api/demo.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "spike:send": "tsx src/spike/proactive-send.ts",
    "llm:check": "tsx src/spike/llm-check.ts",
    "live:run": "tsx src/spike/live-ingest.ts",
    "live:snapshot": "tsx src/spike/live-snapshot.ts",
    "phase3:preflight": "tsx src/spike/phase3-preflight.ts",
    "phase3:live": "tsx src/spike/live-phase3.ts",
    "phase3:audit": "tsx src/spike/phase3-audit.ts",
    "phase4:audit": "tsx src/spike/phase4-audit.ts",
    "phase4:controls": "tsx src/spike/phase4-control-check.ts",
    "tone:smoke": "tsx src/spike/tone-smoke.ts",
    "remind:now": "tsx src/remind-now.ts",
    "build:api": "esbuild src/demo-api.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=api/demo.js --banner:js=\"// GENERATED by 'npm run build:api' from src/demo-api.ts — do not edit. Committed because Vercel resolves vercel.json 'functions' patterns before the build runs.\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@hono/node-server": "^1.19.5",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/functions": "^3.9.3",
    "dotenv": "^17.4.2",
    "hono": "^4.9.8",
    "node-cron": "^4.6.0",
    "sharp": "^0.35.3",
    "spectrum-ts": "^12.7.0",
    "tsx": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5"
  },
  "overrides": {
    "@opentelemetry/core": "2.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
